<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- The analyzers ship inside the package; a project reference doesn't bring them, so add them the way the package does. -->
  <ItemGroup>
    <ProjectReference Include="..\..\src\StructuredConcurrency.Analyzers\StructuredConcurrency.Analyzers.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\StructuredConcurrency\StructuredConcurrency.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

</Project>
