<Project>

  <!-- Shared by every package in src/. They are versioned and released together. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsAotCompatible>true</IsAotCompatible>

    <Version>0.11.0</Version>
    <Authors>Gokhan Ertogan</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <Copyright>Copyright (c) 2026 Gokhan Ertogan</Copyright>
    <PackageProjectUrl>https://github.com/gokhanertogan/StructuredConcurrency</PackageProjectUrl>
    <RepositoryUrl>https://github.com/gokhanertogan/StructuredConcurrency</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReleaseNotes>https://github.com/gokhanertogan/StructuredConcurrency/blob/main/CHANGELOG.md</PackageReleaseNotes>

    <!-- Source Link: lets consumers step into this code from the debugger. -->
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <ItemGroup>
    <!-- NuGet gets a short README of its own; the full one on GitHub is too long for a package page. -->
    <None Include="$(MSBuildThisFileDirectory)..\docs\nuget-readme.md" Pack="true" PackagePath="\README.md" />
    <None Include="$(MSBuildThisFileDirectory)..\docs\assets\icon.png" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
