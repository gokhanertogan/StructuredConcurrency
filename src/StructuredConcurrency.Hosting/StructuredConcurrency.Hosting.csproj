<Project Sdk="Microsoft.NET.Sdk">

  <!-- Shared settings, including the version, are in src/Directory.Build.props. -->
  <PropertyGroup>
    <PackageId>StructuredConcurrency.Hosting</PackageId>
    <Title>StructuredConcurrency.Hosting: structured concurrency for BackgroundService</Title>
    <Description>A BackgroundService whose work runs in a StructuredConcurrency TaskGroup: on shutdown every child task is cancelled and awaited, and a failing child stops the service with its real exception instead of leaving work running in the background, or restarts the service's work as a RestartPolicy allows.</Description>
    <PackageTags>backgroundservice;hostedservice;worker;hosting;graceful-shutdown;structured-concurrency;taskgroup;async;cancellation;supervisor;restart</PackageTags>

    <!-- Fails the pack if the public API breaks compatibility with the last release. -->
    <EnablePackageValidation>true</EnablePackageValidation>
    <PackageValidationBaselineVersion>0.10.0</PackageValidationBaselineVersion>

    <!-- RS0026/RS0027 are API design rules about optional parameters on overloads. The API already shipped that way;
         only the tracking rules are wanted. -->
    <NoWarn>$(NoWarn);RS0026;RS0027</NoWarn>
  </PropertyGroup>

  <!-- Records the public API in PublicAPI.Shipped.txt and PublicAPI.Unshipped.txt, so a change to it shows up in review and
       has to be made on purpose. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" Version="5.0.0" PrivateAssets="all" />
    <AdditionalFiles Include="PublicAPI.Shipped.txt" />
    <AdditionalFiles Include="PublicAPI.Unshipped.txt" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\StructuredConcurrency\StructuredConcurrency.csproj" />
  </ItemGroup>

</Project>
