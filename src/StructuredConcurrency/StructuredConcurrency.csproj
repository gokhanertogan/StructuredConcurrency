<Project Sdk="Microsoft.NET.Sdk">

  <!-- Shared settings, including the version, are in src/Directory.Build.props. -->
  <PropertyGroup>
    <PackageId>StructuredConcurrency</PackageId>
    <Title>StructuredConcurrency: TaskGroup and Promise.all / Promise.any for C#</Title>
    <Description>Structured concurrency for C# and .NET. Run tasks in parallel in a TaskGroup: the first failure cancels the rest, no task outlives the group, and you get the real error instead of a TaskCanceledException. Includes C# equivalents of JavaScript's Promise.all, Promise.any and Promise.allSettled (TaskGroup.AllAsync, AnyAsync and AllSettledAsync), a concurrency limit, timeouts that cancel the work (Kotlin's withTimeout), bounded parallel streams of results, Go's singleflight, Go's select for System.Threading.Channels, and OpenTelemetry tracing.</Description>
    <PackageTags>async;await;task;tasks;taskgroup;structured-concurrency;concurrency;parallel;cancellation;cancellationtoken;whenall;whenany;promise;promise-all;promise-any;allsettled;fail-fast;errgroup;semaphoreslim;max-concurrency;throttling;channels;go;select;fan-in;fan-out;timeout;withtimeout;singleflight;cache-stampede;as-completed;iasyncenumerable;timeprovider;opentelemetry;tracing</PackageTags>

    <!-- Fails the pack if the public API breaks compatibility with the last release. -->
    <EnablePackageValidation>true</EnablePackageValidation>
    <PackageValidationBaselineVersion>0.4.0</PackageValidationBaselineVersion>
  </PropertyGroup>

</Project>
