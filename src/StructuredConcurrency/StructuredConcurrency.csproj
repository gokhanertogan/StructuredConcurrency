<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsAotCompatible>true</IsAotCompatible>

    <PackageId>StructuredConcurrency</PackageId>
    <Version>0.2.0</Version>
    <Authors>Gokhan Ertogan</Authors>
    <Description>Structured concurrency for .NET: child tasks run inside a scope that completes only when all of them have finished, and the first failure cancels the rest.</Description>
    <PackageTags>async;tasks;structured-concurrency;cancellation;taskgroup</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <Copyright>Copyright (c) 2026 Gokhan Ertogan</Copyright>
    <PackageProjectUrl>https://github.com/gokhanertogan/StructuredConcurrency</PackageProjectUrl>
    <RepositoryUrl>https://github.com/gokhanertogan/StructuredConcurrency</RepositoryUrl>
    <RepositoryType>git</RepositoryType>

    <!-- Source Link: lets consumers step into this code from the debugger. -->
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
