<Project Sdk="Microsoft.NET.Sdk">

  <!-- Ships inside the StructuredConcurrency package next to the analyzers. Kept apart from them because it needs
       Microsoft.CodeAnalysis.Workspaces, which command-line builds don't load. -->
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <IsAotCompatible>false</IsAotCompatible>
    <IsPackable>false</IsPackable>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <!-- Not an API anyone calls, so no XML documentation file. -->
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="4.8.0" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.Analyzers" Version="3.3.4" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\StructuredConcurrency.Analyzers\StructuredConcurrency.Analyzers.csproj" />
  </ItemGroup>

</Project>
