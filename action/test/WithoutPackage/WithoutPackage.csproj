<Project Sdk="Microsoft.NET.Sdk">
  <!-- Doesn't reference StructuredConcurrency. Two target frameworks, so each finding is reported twice by the build
       and must be counted once; warnings are errors, so the check must not break the build. -->
  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
</Project>
